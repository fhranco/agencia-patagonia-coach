# PatagoniaCoach Environment Configuration Template
# IMPORTANT: Never commit actual secret values. Use [REDACTED] in documentation.

# Application Environment (production | staging | development)
VITE_APP_ENV=staging

# Canonical Site URL
VITE_SITE_URL=https://staging.agenciapatagoniacoach.cl

# Analytics Measurement ID (Leave empty in staging)
VITE_GA_ID=

# AI Backend Configuration (Server-Side only in Vercel / .env.local)
AI_API_KEY=
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_MODEL=deepseek-chat

# Database Persistence (Supabase PostgreSQL - Server-Side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
